APP_NAME=TechNomadSpace
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-api.run.app
FRONTEND_URL=https://technomadspace.pages.dev

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================
# Database (Turso) - 開発・本番共通
# ============================================
DB_CONNECTION=libsql
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# ============================================
# Session / Cache / Queue
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ============================================
# Mail (Resend)
# ============================================
MAIL_MAILER=resend
RESEND_API_KEY=your-resend-api-key
MAIL_FROM_ADDRESS=noreply@technomadspace.com
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# Google OAuth
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://technomadspace.pages.dev/auth/callback

# ============================================
# Firebase Cloud Messaging (FCM)
# ============================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FCM_LOGGING_ENABLED=false
FCM_THROW_EXCEPTIONS=false
